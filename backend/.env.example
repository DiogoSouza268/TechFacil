# Chave de acesso da OpenRouter
OPENROUTER_API_KEY=

# Modelos gratuitos permitidos para o Facilito.AI
OPENROUTER_MODELS=

# Configurações do servidor
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200

# String do Session Pooler do Supabase com senha só de letras e números
DATABASE_URL=postgresql://postgres.SEU_CODIGO:SuaSenhaSoComLetrasENumeros@aws-0-sa-east-1.pooler.supabase.com:5432/postgres